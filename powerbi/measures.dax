// Power BI measures for the Olist model.
// Load powerbi/fact_orders.csv, dim_date.csv, dim_state.csv, dim_category.csv (generated by
// analysis/build_dashboard.py). Relationships: fact_orders[purchase_date] -> dim_date[date],
// fact_orders[customer_state] -> dim_state[state], fact_orders[main_category] -> dim_category[category].

Orders = COUNTROWS ( fact_orders )

GMV (BRL) = SUM ( fact_orders[order_value] )

AOV (BRL) = DIVIDE ( [GMV (BRL)], [Orders] )

Late Orders = CALCULATE ( [Orders], fact_orders[is_late] = TRUE () )

Late Rate = DIVIDE ( [Late Orders], [Orders] )

Avg Review = AVERAGE ( fact_orders[review_score] )

Negative Review Rate =
DIVIDE (
    CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[review_score] <= 2 ),
    CALCULATE ( COUNTROWS ( fact_orders ), NOT ISBLANK ( fact_orders[review_score] ) )
)

// Late orders above what the national late rate predicts for this slice's volume.
// Rank routes or states by this, not by raw late rate: it combines rate and volume.
Excess Late Orders =
VAR NationalRate = CALCULATE ( [Late Rate], REMOVEFILTERS ( fact_orders[customer_state], fact_orders[route] ) )
RETURN [Late Orders] - [Orders] * NationalRate

Repeat Customer Rate =
VAR Customers = DISTINCTCOUNT ( fact_orders[customer_unique_id] )
VAR Repeaters =
    COUNTROWS (
        FILTER (
            VALUES ( fact_orders[customer_unique_id] ),
            CALCULATE ( COUNTROWS ( fact_orders ) ) >= 2
        )
    )
RETURN DIVIDE ( Repeaters, Customers )
